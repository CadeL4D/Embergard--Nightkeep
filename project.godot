; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Embergard: Nightkeep"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

; Locale first: everything below may want to translate a string while starting up.
Locale="*res://scripts/core/locale.gd"
Events="*res://scripts/core/events.gd"
Sim="*res://scripts/core/sim.gd"
World="*res://scripts/world/world.gd"
Colony="*res://scripts/colony/colony.gd"
Divine="*res://scripts/divine/divine.gd"
Threat="*res://scripts/threat/threat.gd"
Meta="*res://scripts/meta/meta.gd"
Audio="*res://scripts/audio/audio.gd"
Ui="*res://scripts/ui/ui.gd"

[display]

; 20:9 — a modern phone held sideways. 16:9 (640x360) was both wrong for the target device and
; too narrow for the HUD: the resource readout and the phase clock together needed most of the
; width, so the top of the screen was permanently crowded. The extra 160 logical pixels go
; straight into breathing room.
;
; stretch/aspect is "expand", so phones that are not exactly 20:9 show slightly more or less
; world rather than letterboxing.
window/size/viewport_width=800
window/size/viewport_height=360
window/size/window_width_override=1600
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

debug_overlay={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194334,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
